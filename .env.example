# Скопируйте в файл .env (или просто запустите run.py — он создаст его сам) и заполните.
# Ключ Claude API (sk-ant-...)
ANTHROPIC_API_KEY=
# Домен сайта на Хорошоп (например myshop.com.ua, без https:// и /api)
HOROSHOP_DOMAIN=
# Логин API-администратора Хорошоп (Налаштування -> Адміни)
HOROSHOP_LOGIN=
# Пароль API-администратора Хорошоп
HOROSHOP_PASSWORD=
